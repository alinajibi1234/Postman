{
  "info": {
    "name": "ECommerce Tests",
    "_postman_id": "ecommerce-tests-0001",
    "description": "Integration tests for the Users, Payments and Orders Web APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users API",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrlUsers}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hanna\",\n  \"email\": \"han@gmail.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"User created successfully\", () => pm.response.to.have.status(201));",
                  "const jsonData = pm.response.json();",
                  "pm.environment.set(\"userId\", jsonData.id);",
                  "pm.test(\"User ID saved\", () => pm.expect(pm.environment.get(\"userId\")).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User by Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrlUsers}}/api/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Correct user returned\", () => pm.expect(jsonData.id).to.eql(Number(pm.environment.get(\"userId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrlUsers}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        }
      ]
    },
