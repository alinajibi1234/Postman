                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"User created successfully\", () => pm.response.to.have.status(201));",
                      "const jsonData = pm.response.json();",
                      "pm.environment.set(\"userId\", jsonData.id);",
                      "pm.test(\"User ID saved\", () => pm.expect(pm.environment.get(\"userId\")).to.exist);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "6.2 Create order without paymentId (expect 400)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrlOrders}}/api/orders",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"userId\": {{userId}},\n  \"total\": 200.00\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 400 Bad Request\", () => pm.response.to.have.status(400));"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
